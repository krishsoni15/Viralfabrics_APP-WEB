{
  "name": "viral-fabrics-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "ts:check": "tsc",
    "test": "jest",
    "build": "npx tsc --noEmit && npx expo export",
    "postinstall": "node patch-gradle.js",
    "update:staging": "node -e \"const fs=require('fs'); fs.copyFileSync('env.staging', '.env'); console.log('[✓] Swapped to staging env');\" && npx eas-cli update --channel staging --clear-cache",
    "update:production": "node -e \"const fs=require('fs'); fs.copyFileSync('env.production', '.env'); console.log('[✓] Swapped to production env');\" && npx eas-cli update --channel production --clear-cache",
    "build:ios": "./run-ios.sh"

  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.28.4",
    "axios": "^1.6.8",
    "expo": "~54.0.0",
    "expo-blur": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-media-library": "~18.2.1",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.24",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.19",
    "jszip": "^3.10.1",
    "lucide-react-native": "^0.363.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "babel-preset-expo": "~54.0.10",
    "jest": "~29.7.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
