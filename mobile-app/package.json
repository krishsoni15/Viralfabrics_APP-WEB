{
  "name": "viral-fabrics-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "ts:check": "tsc",
    "test": "jest",
    "build": "npx tsc --noEmit && npx expo export",
    "postinstall": "node patch-gradle.js",
    "update:staging": "node -e \"const fs=require('fs'); fs.copyFileSync('env.staging', '.env'); console.log('[✓] Swapped to staging env');\" && npx eas-cli update --channel staging --clear-cache",
    "update:production": "node -e \"const fs=require('fs'); fs.copyFileSync('env.production', '.env'); console.log('[✓] Swapped to production env');\" && npx eas-cli update --channel production --clear-cache",
    "build:ios": "./run-ios.sh"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/native": "^7.3.14",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.28.4",
    "axios": "^1.6.8",
    "expo": "^56.0.17",
    "expo-blur": "~56.0.4",
    "expo-camera": "~56.0.8",
    "expo-constants": "~56.0.22",
    "expo-dev-client": "~56.0.24",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.11",
    "expo-image-manipulator": "~56.0.23",
    "expo-image-picker": "~56.0.22",
    "expo-linking": "~56.0.16",
    "expo-media-library": "~56.0.10",
    "expo-print": "~56.0.4",
    "expo-router": "~56.2.16",
    "expo-sharing": "~56.0.23",
    "expo-splash-screen": "~56.0.14",
    "expo-status-bar": "~56.0.4",
    "expo-updates": "~56.0.23",
    "jszip": "^3.10.1",
    "lucide-react-native": "^0.363.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.3",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.14",
    "babel-plugin-react-compiler": "^1.0.0",
    "babel-preset-expo": "~56.0.0",
    "jest": "~29.7.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
